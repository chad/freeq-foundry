    "@freeq-foundry/sandbox": "workspace:*",
    "@freeq/bot-kit": "file:../../../freeq/freeq-bot-kit-js",
    "@freeq/sdk": "file:../../../freeq/freeq-sdk-js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
