{
  "name": "@freeq-foundry/foundry-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Heterogeneous Foundry agents that live on the freeq network",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "foundry-agent": "./dist/cli.js"
  },
  "engines": {
