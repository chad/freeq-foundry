      "name": "recorder-signature-cleared",
      "note": "Position attestation must be checked, not assumed.",
      "patches": [
        {
          "op": "replace",
          "path": "/1/recorderSignature",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        }
      ],
      "expectValid": false,
      "expectCodes": [
        "INVALID_RECORDER_SIGNATURE"
      ],
      "expectFirstBadIndex": 1
    },
    {
      "name": "sequence-replayed",
      "note": "Stale and gapped are distinct: a gap means loss, a stale value means replay.",
      "patches": [
        {
          "op": "replace",
          "path": "/4/participantSequence",
          "value": 1
        }
      ],
      "expectValid": false,
      "expectCodes": [
        "STALE_SEQUENCE"
      ],
      "expectFirstBadIndex": 4
    },
    {
      "name": "logical-time-rewound",
      "patches": [
        {
          "op": "replace",
          "path": "/2/logicalTime",
          "value": 0
        }
      ],
      "expectValid": false,
      "expectCodes": [
        "NON_MONOTONIC_LOGICAL_TIME"
      ],
      "expectFirstBadIndex": 2
    }
  ]
}
