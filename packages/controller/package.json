{
  "name": "@freeq-foundry/controller",
  "version": "0.1.0",
  "description": "Run orchestration from genesis to termination",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
